{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ngenpainai",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "const h=require('http'),f=require('fs'),p=require('path');const t={'.html':'text/html; charset=utf-8','.css':'text/css','.js':'text/javascript','.woff2':'font/woff2'};h.createServer((q,r)=>{let u=decodeURIComponent(q.url.split('?')[0]);if(u==='/')u='/index.html';const fp=p.join(process.cwd(),p.normalize(u));if(!fp.startsWith(process.cwd())){r.writeHead(403);return r.end()}f.readFile(fp,(e,d)=>{if(e){r.writeHead(404);return r.end('not found')}r.writeHead(200,{'Content-Type':t[p.extname(fp)]||'application/octet-stream','Cache-Control':'no-store'});r.end(d)})}).listen(process.env.PORT||5173,function(){console.log('http://localhost:'+this.address().port)})"
      ],
      "port": 5173
    }
  ]
}
