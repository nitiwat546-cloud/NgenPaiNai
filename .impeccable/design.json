      "html": "<ul class=\"ds-panel\"><li><button class=\"ds-tx\"><span class=\"ds-tile\" style=\"background:#d9b48f\"><svg viewBox=\"0 0 24 24\" width=\"20\" height=\"20\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6.5 8h11l-1.4 12.2a1 1 0 0 1-1 .8H8.9a1 1 0 0 1-1-.8Z\"/><path d=\"m12 8 1.6-5H17M7 13h10\"/></svg></span><span class=\"ds-main\"><span>กาแฟ</span><small>เครื่องดื่ม</small></span><b>−฿55</b></button></li></ul>",
      "css": ".ds-panel{list-style:none;margin:0;padding:0;width:340px;background:var(--panel,#1a1a1a);border-radius:16px;clip-path:polygon(0 0,calc(100% - 18px) 0,100% 18px,100% 100%,0 100%);overflow:hidden}.ds-tx{width:100%;display:flex;align-items:center;gap:12px;padding:12px 14px;min-height:60px;border:none;background:none;color:var(--ink,#f4f4ee);font-family:\"Anuphan\",sans-serif;font-size:16px;text-align:left;cursor:pointer}.ds-tx:hover{background:var(--panel-2,#242424)}.ds-tx:focus-visible{outline:2px solid #d4ff2a;outline-offset:-2px}.ds-tile{flex:none;width:38px;height:38px;display:grid;place-items:center;border-radius:10px;color:#0f0f0f}.ds-main{flex:1;display:flex;flex-direction:column;font-weight:500}.ds-main small{font-size:.82rem;color:var(--muted,#a6a69c);font-weight:400}.ds-tx b{font-weight:600;font-variant-numeric:tabular-nums}"
    },
    {
